[Unit]
Description=Truck GPS dashboard server
After=network-online.target gps-tracker.service
Wants=network-online.target

[Service]
Type=simple
# install_services.sh 가 현재 사용자/경로로 덮어씁니다
User=infrax
Group=infrax
WorkingDirectory=/home/infrax/truck_gps
ExecStart=/home/infrax/truck_gps/gps_env/bin/python /home/infrax/truck_gps/dashboard_server.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
